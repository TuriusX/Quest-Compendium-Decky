{
  "name": "quest-compendium-decky",
  "version": "0.1.2",
  "description": "Quest Compendium for Steam Deck: an AI game guide in the Quick Access menu.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "package": "rollup -c && python3 scripts/package.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuriusX/quest-compendium-decky.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "ai",
    "game-guide"
  ],
  "author": "Noah Minton",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/TuriusX/quest-compendium-decky/issues"
  },
  "homepage": "https://questcompendium.com",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode-generator": "^2.0.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
